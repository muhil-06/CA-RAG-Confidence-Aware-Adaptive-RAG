# --- Mode selection ---
# "api"   -> use Anthropic API (claude-haiku / claude-sonnet)
# "local" -> use a local Ollama model (free, no API key needed)
MODE=api

# --- Anthropic API settings (only needed if MODE=api) ---
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Ollama settings (only needed if MODE=local) ---
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# --- Confidence gate settings ---
CONFIDENCE_THRESHOLD=70

# --- Retrieval settings ---
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=ca_rag_docs

# --- Embedding model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
